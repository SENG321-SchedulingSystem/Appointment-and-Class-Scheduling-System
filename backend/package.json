{
  "name": "scheduling-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js / Express REST API for the Appointment and Class Scheduling System (openapi.yaml v0.3.0)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "emulator": "npx --yes firebase-tools emulators:start --only firestore --project demo-scheduling",
    "test": "jest",
    "seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageThreshold": {
      "global": {
        "statements": 50,
        "branches": 50,
        "functions": 50,
        "lines": 50
      }
    }
  }
}

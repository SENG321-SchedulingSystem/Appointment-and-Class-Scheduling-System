# Copy to .env (never commit .env) and adjust.

NODE_ENV=development
PORT=3000

# Required in production. Use a long random string.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Browser origins allowed to call the API, comma-separated.
# Development default: the Vite dev server (http://localhost:5173).
# Production: set to the deployed frontend URL, e.g. https://<app>.vercel.app
# CORS_ORIGINS=http://localhost:5173

# Firebase / Firestore
# A "demo-" project id runs fully offline against the Firebase Local Emulator.
FIREBASE_PROJECT_ID=demo-scheduling
# Set to use the emulator; leave empty to use Cloud Firestore with
# Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
FIRESTORE_EMULATOR_HOST=localhost:8080

# Seed script (npm run seed). In development it falls back to
# admin@example.com / Admin12345 plus a demo instructor and student.
# Required in production; only the admin is created there.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

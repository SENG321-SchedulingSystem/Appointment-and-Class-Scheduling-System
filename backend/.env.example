# Copy to .env (never commit .env) and adjust.

NODE_ENV=development
PORT=3000

# Required in production. Use a long random string.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Firebase / Firestore
# A "demo-" project id runs fully offline against the Firebase Local Emulator.
FIREBASE_PROJECT_ID=demo-scheduling
# Set to use the emulator; leave empty to use Cloud Firestore with
# Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
FIRESTORE_EMULATOR_HOST=localhost:8080
